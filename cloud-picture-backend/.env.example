# 当前使用的 Spring 配置环境；本地开发可使用 prod 配置
SPRING_PROFILES_ACTIVE=prod

# Docker Compose 映射端口
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL 容器 root 密码
MYSQL_ROOT_PASSWORD=

# API 网关端口
GATEWAY_PORT=8080

# 用户服务端口和独立数据库配置
USER_SERVICE_PORT=8081
USER_MYSQL_HOST=127.0.0.1
USER_MYSQL_PORT=3306
USER_MYSQL_DATABASE=picture_user
USER_MYSQL_USERNAME=root
USER_MYSQL_PASSWORD=

# 图片服务端口和独立数据库配置
IMAGE_SERVICE_PORT=8082
IMAGE_MYSQL_HOST=127.0.0.1
IMAGE_MYSQL_PORT=3306
IMAGE_MYSQL_DATABASE=picture_image
IMAGE_MYSQL_USERNAME=root
IMAGE_MYSQL_PASSWORD=

# AI 服务端口
AI_SERVICE_PORT=8083

# 支付服务端口和独立数据库配置
PAYMENT_SERVICE_PORT=8084
PAYMENT_MYSQL_HOST=127.0.0.1
PAYMENT_MYSQL_PORT=3306
PAYMENT_MYSQL_DATABASE=picture_payment
PAYMENT_MYSQL_USERNAME=root
PAYMENT_MYSQL_PASSWORD=

# Redis 连接配置
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_DATABASE=0

# Nacos 服务发现地址
NACOS_ADDR=127.0.0.1:8848

# 图片服务调用用户服务的内部令牌
INTERNAL_TOKEN=

# Redis 登录会话有效期，单位：秒
SESSION_TTL_SECONDS=604800

# 图片上传限制
IMAGE_MAX_FILE_SIZE=10MB
IMAGE_MAX_REQUEST_SIZE=12MB

# AI 元数据接口的文件大小限制（与上传边界一致）
AI_MAX_FILE_SIZE=10MB
AI_MAX_REQUEST_SIZE=12MB

# 腾讯云 COS 配置
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=
COS_SIGN_EXPIRE_SECONDS=3600

# Pexels 图源导入（真实 Key 只放在本地 .env，不要提交）
PEXELS_API_KEY=
PEXELS_API_BASE_URL=https://api.pexels.com/v1

# 阿里云百炼 qwen3-vl-flash（真实 Key 只放在本地 .env，不要提交；不打印到日志）
DASHSCOPE_API_KEY=

# AI 自动审核（每日凌晨 0 点批量审图；演示可临时把 cron 调成 */30 * * * * ? 秒级轮询）
AI_REVIEW_ENABLED=true
AI_REVIEW_CRON=0 0 0 * * ?
AI_REVIEW_PASS_THRESHOLD=80
AI_REVIEW_BLOCK_THRESHOLD=90

# 私有空间套餐到期降级（每日凌晨 0 点扫描过期套餐降回 FREE；演示可临时调高频）
SPACE_TIER_EXPIRE_CRON=0 0 0 * * ?

# 支付通道：mock（内置模拟支付，断网可演示）/ alipay（支付宝沙箱）
PAYMENT_CHANNEL=mock
# 未支付订单的超时关单时长（分钟）
PAYMENT_ORDER_TIMEOUT_MINUTES=30

# 支付宝沙箱（真实密钥只放在本地 .env，不要提交；不打印到日志）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（验签用，不是应用公钥）
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 异步通知地址，必须公网可达（本地演示用 natapp/ngrok 之类隧道）
ALIPAY_NOTIFY_URL=
# 浏览器回跳地址（只用于落页，不作为授权依据）
ALIPAY_RETURN_URL=
