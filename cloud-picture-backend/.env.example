# 当前使用的 Spring 配置环境；本地开发可使用 prod 配置
SPRING_PROFILES_ACTIVE=prod

# Docker Compose 映射端口
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL 容器 root 密码
MYSQL_ROOT_PASSWORD=

# API 网关端口
GATEWAY_PORT=8080

# 用户服务端口和独立数据库配置
USER_SERVICE_PORT=8081
USER_MYSQL_HOST=127.0.0.1
USER_MYSQL_PORT=3306
USER_MYSQL_DATABASE=picture_user
USER_MYSQL_USERNAME=root
USER_MYSQL_PASSWORD=

# 图片服务端口和独立数据库配置
IMAGE_SERVICE_PORT=8082
IMAGE_MYSQL_HOST=127.0.0.1
IMAGE_MYSQL_PORT=3306
IMAGE_MYSQL_DATABASE=picture_image
IMAGE_MYSQL_USERNAME=root
IMAGE_MYSQL_PASSWORD=

# Redis 连接配置
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_DATABASE=0

# Nacos 服务发现地址
NACOS_ADDR=127.0.0.1:8848

# 图片服务调用用户服务的内部令牌
INTERNAL_TOKEN=

# Redis 登录会话有效期，单位：秒
SESSION_TTL_SECONDS=604800

# 图片上传限制
IMAGE_MAX_FILE_SIZE=10MB
IMAGE_MAX_REQUEST_SIZE=12MB

# 腾讯云 COS 配置
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=
COS_SIGN_EXPIRE_SECONDS=3600

# Pexels 图源导入（真实 Key 只放在本地 .env，不要提交）
PEXELS_API_KEY=
PEXELS_API_BASE_URL=https://api.pexels.com/v1
